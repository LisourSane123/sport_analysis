# ---------- WAGA (Xiaomi Mi Scale 2 / MIBFS) ----------
# MAC wagi. Znajdziesz go: python3 -m app.scale.discover
SCALE_MAC=00:00:00:00:00:00

# Czas jednego cyklu skanowania BLE (sekundy)
SCAN_DURATION=20
# Przerwa miedzy cyklami (sekundy)
SCAN_INTERVAL=10

# ---------- ROZPOZNAWANIE UZYTKOWNIKA ----------
# Pomiar trafia do profilu, w ktorego przedzial predykcyjny sie wpisuje.
IDENT_WINDOW_DAYS=7        # ile dni historii bierzemy pod uwage
IDENT_CONFIDENCE=0.95      # poziom ufnosci przedzialu
IDENT_SD_PRIOR=0.8         # zakladane wahania dobowe wagi [kg] (przy malej liczbie pomiarow)
IDENT_NU_PRIOR=2           # sila tego zalozenia (pseudo-obserwacje)
IDENT_SD_FLOOR=0.2         # minimalne odchylenie [kg]
IDENT_MAX_HALF_KG=6        # maksymalna polszerokosc przedzialu [kg]
IDENT_FALLBACK_MAX_KG=8    # dalej niz tyle od ostatniej wagi -> pomiar nieprzypisany

# ---------- BAZA ----------
DB_PATH=data/waga.db

# ---------- DASHBOARD ----------
WEB_HOST=0.0.0.0
WEB_PORT=11230

# ---------- STRAVA ----------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Co ile sekund automatyczny sync aktywnosci (domyslnie 30 min)
STRAVA_SYNC_INTERVAL=1800

# ---------- GARMIN CONNECT ----------
# Logowanie idzie przez nieoficjalne API (biblioteka garminconnect).
# Zalecane: zostaw ponizsze puste i zaloguj sie raz recznie:
#   python3 -m app.garmin.auth
# Tokeny zapisza sie w GARMIN_TOKENSTORE i beda odswiezane automatycznie.
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_TOKENSTORE=data/garmin_tokens
# Co ile sekund automatyczny sync (domyslnie godzina)
GARMIN_SYNC_INTERVAL=3600
# Ile dni wstecz dociagac przy pierwszym uruchomieniu
GARMIN_BACKFILL_DAYS=30
# Przerwa miedzy zapytaniami [s] - Garmin nie lubi serii bez oddechu
GARMIN_REQUEST_PAUSE=1.0
